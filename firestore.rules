rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHighScoreEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'maxCombo', 'levelReached', 'bricksCleared', 'mode', 'createdAt']) &&
        data.keys().hasOnly(['playerName', 'score', 'maxCombo', 'levelReached', 'bricksCleared', 'mode', 'createdAt']) &&
        data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 20 &&
        data.score is number && data.score >= 0 && data.score <= 10000000 &&
        data.maxCombo is number && data.maxCombo >= 0 && data.maxCombo <= 1000 &&
        data.levelReached is number && data.levelReached >= 1 && data.levelReached <= 100 &&
        data.bricksCleared is number && data.bricksCleared >= 0 && data.bricksCleared <= 50000 &&
        data.mode is string && (data.mode == 'SOLO' || data.mode == 'VS_2P') &&
        data.createdAt == request.time;
    }

    // Public community leaderboard - players can read top scores and submit new verified runs
    match /leaderboard/{entryId} {
      allow get, list: if true;
      allow create: if isValidId(entryId) && isValidHighScoreEntry(request.resource.data);
      allow update, delete: if false;
    }
  }
}
